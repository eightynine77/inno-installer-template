; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

; ======================
; change the details below to match your program/software
#define MyAppName "pally file paste"
#define MyAppVersion "1.1.0"
#define MyAppPublisher "jebbidan"
#define MyAppURL "https://jebbidan.great-site.net/"
#define MyAppExeName "pallyFilePaste.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{6AE928C4-08DA-4132-8727-E10BE712EDCB}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

SetupArchitecture=x64
ArchitecturesAllowed=x64os
ArchitecturesInstallIn64BitMode=x64os
; comment out/remove both ArchitecturesInstallIn64BitMode, SetupArchitecture, and ArchitecturesAllowed if you want this installer to be 32-bit (inno setup creates 32-bit installer by default)

DisableWelcomePage=no
WizardImageFile=C:\Users\jebbidan youtube\my_coding_stuff\vscode_projects\c#\pally-file-paste\pallyFilePaste\Assets\PallyPasteFile_installer_bigimage.png
WizardSmallImageFile=C:\Users\jebbidan youtube\my_coding_stuff\vscode_projects\c#\pally-file-paste\pallyFilePaste\Assets\PallyPasteFile_installer_smallimage.png
; the images for installer
; WizardSmallImageFile is for the top-right corner image
; WizardImageFile is for the image on the left side at the installer's startup

DefaultDirName={autopf}\{#MyAppName}

; the icon for the app's uninstaller
UninstallDisplayIcon="{app}\{#MyAppExeName}"

DisableProgramGroupPage=yes
LicenseFile=C:\Users\jebbidan youtube\my_coding_stuff\LICENSE-AGPLv3.txt
InfoBeforeFile=C:\Users\jebbidan youtube\my_coding_stuff\dotnet install reminder.rtf
; Remove the following line to run in administrative install mode (install for all users.)
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=C:\Users\jebbidan youtube\my_coding_stuff\my_installer
OutputBaseFilename=pally file paste
SetupIconFile=C:\Users\jebbidan youtube\my_coding_stuff\vscode_projects\c#\pally-file-paste\pallyFilePaste\Assets\PallyPasteFile_desktopIcon.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Messages]
WelcomeLabel1=welcome to pally file paste setup v{#MyAppVersion}
WelcomeLabel2=this wizard will install pally file paste v{#MyAppVersion} on your computer 

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

